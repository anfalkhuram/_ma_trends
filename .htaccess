# ----------------------------------------------------------------------
# Custom Error Pages (matrends.store)
# ----------------------------------------------------------------------
ErrorDocument 400 /400.php
ErrorDocument 401 /401.php
ErrorDocument 403 /403.php
ErrorDocument 404 /404.php
ErrorDocument 405 /405.php
ErrorDocument 408 /408.php
ErrorDocument 409 /409.php
ErrorDocument 413 /413.php
ErrorDocument 429 /429.php
ErrorDocument 500 /500.php
ErrorDocument 501 /501.php
ErrorDocument 502 /502.php
ErrorDocument 503 /503.php
ErrorDocument 504 /504.php

# ----------------------------------------------------------------------
# URL Rewriting & HTTPS Enforcement
# ----------------------------------------------------------------------
RewriteEngine On

# Force HTTPS but keep the domain exactly as requested (no www enforcement)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Hide .php extensions and ensure query strings are passed [QSA]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L,QSA]

# ----------------------------------------------------------------------
# Security Headers
# ----------------------------------------------------------------------
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-XSS-Protection "1; mode=block"
Header unset X-Powered-By
Header always unset Server

# ----------------------------------------------------------------------
# Directory Listing
# ----------------------------------------------------------------------
Options -Indexes

# ----------------------------------------------------------------------
# Block access to sensitive files and directories
# ----------------------------------------------------------------------
<FilesMatch "(test\.txt|report\.tldr|\.gitattributes)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    # Block .git directory
    RewriteRule ^\.git - [F,L]
    
    # Block PHP execution in upload directories
    RewriteRule ^assets/img/receipts/.*\.php$ - [F,L]
</IfModule>
